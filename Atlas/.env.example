# Copy to .env — do not commit real secrets.

# Hosted Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Public URL where the Flutter web app is served (password reset + email links)
APP_URL=https://your-app.example.com

# CLI: supabase link / db push (optional; from `supabase login`)
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Brevo — used by scripts/host-supabase.sh for edge function secrets (not in Flutter)
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Atlas
